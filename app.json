{
	"expo": {
		"name": "Alternate",
		"slug": "alternate",
		"version": "2.4.7",
		"orientation": "portrait",
		"scheme": "alternate",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"icon": "./assets/icon/adaptive-icon.png",
		"ios": {
			"supportsTablet": true,
			"icon": {
				"dark": "./assets/icon/ios-dark.png",
				"light": "./assets/icon/ios-light.png",
				"tinted": "./assets/icon/ios-tinted.png"
			},
			"runtimeVersion": {
				"policy": "appVersion"
			}
		},
		"android": {
			"versionCode": 15,
			"adaptiveIcon": {
				"foregroundImage": "./assets/icon/adaptive-icon.png",
				"monochromeImage": "./assets/icon/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"icon": "./assets/icon/adaptive-icon.png",
			"edgeToEdgeEnabled": true,
			"package": "com.lulu786.Alternate",
			"runtimeVersion": "1.0.0"
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/icon/favicon.png"
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			[
				"expo-image-picker",
				{
					"photosPermission": "The app accesses your photos to let you select contact profile pictures.",
					"cameraPermission": "The app accesses your camera to let you take contact profile pictures."
				}
			],
			[
				"expo-splash-screen",
				{
					"image": "./assets/icon/splash-icon-dark.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"dark": {
						"image": "./assets/icon/splash-icon-light.png",
						"backgroundColor": "#000000"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "0f06f9c0-1e64-4c3a-aa39-4724ca395d4f"
			}
		},
		"owner": "lulu786",
		"updates": {
			"url": "https://u.expo.dev/0f06f9c0-1e64-4c3a-aa39-4724ca395d4f"
		}
	}
}
